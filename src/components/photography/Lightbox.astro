---
// Photography lightbox — vanilla dialog + JS in the page wires up event
// handlers against `[data-photo-index]` triggers. Mirrors the StillsGallery
// lightbox pattern.
---

<dialog id="photo-lightbox" class="photo-lightbox" aria-label="Photo viewer">
  <div class="photo-lightbox-inner">
    <button type="button" id="photo-lightbox-close" class="lb-btn lb-close" aria-label="Close">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
        <line x1="6" y1="6" x2="18" y2="18" />
        <line x1="18" y1="6" x2="6" y2="18" />
      </svg>
    </button>

    <button type="button" id="photo-lightbox-prev" class="lb-btn lb-prev" aria-label="Previous">
      <svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="17,4 7,14 17,24" />
      </svg>
    </button>

    <button type="button" id="photo-lightbox-next" class="lb-btn lb-next" aria-label="Next">
      <svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="11,4 21,14 11,24" />
      </svg>
    </button>

    <figure class="lb-figure">
      <img id="photo-lightbox-img" src="" alt="" />
      <figcaption id="photo-lightbox-caption"></figcaption>
    </figure>
  </div>
</dialog>

<style is:global>
  .photo-lightbox {
    background: rgba(10, 10, 10, 0.97);
    color: var(--color-fg, #f0ece4);
    border: none;
    padding: 0;
    margin: 0;
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
  }
  .photo-lightbox::backdrop {
    background: rgba(0, 0, 0, 0.9);
  }

  .photo-lightbox-inner {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }

  .lb-figure {
    margin: 0;
    max-width: 92vw;
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  #photo-lightbox-img {
    max-width: 100%;
    max-height: 85vh;
    object-fit: contain;
    display: block;
  }

  #photo-lightbox-caption {
    font-size: 12px;
    color: var(--color-fg-muted, #9a978f);
    text-align: center;
    letter-spacing: 0.04em;
  }
  #photo-lightbox-caption:empty {
    display: none;
  }

  .lb-btn {
    position: absolute;
    background: transparent;
    border: none;
    color: var(--color-fg-muted, #9a978f);
    cursor: pointer;
    padding: 12px;
    transition: color 150ms ease;
  }
  .lb-btn:hover {
    color: var(--color-fg, #f0ece4);
  }

  .lb-close {
    top: 16px;
    right: 16px;
  }
  .lb-prev {
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
  }
  .lb-next {
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
  }

  @media (max-width: 767px) {
    .lb-prev { left: 4px; }
    .lb-next { right: 4px; }
    .lb-close { top: 8px; right: 8px; }
  }
</style>
