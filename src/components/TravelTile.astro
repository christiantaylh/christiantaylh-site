---
import Image from './Image.astro';

interface Props {
  href: string;
  title: string;
  location: string;
  year: number;
  hero: string;
}

const { href, title, location, year, hero } = Astro.props;
const overlayLabel = location || title;
---

<a href={href} class="travel-tile group">
  <div class="tile-photo">
    <Image
      src={hero}
      alt={`${overlayLabel} ${year}`}
      class="tile-img"
    />
  </div>
  <div class="tile-card">
    <span class="tile-place">{overlayLabel}</span>
    <span class="tile-year">{year}</span>
  </div>
</a>

<style>
  .travel-tile {
    display: block;
    color: inherit;
    text-decoration: none;
    background: #fff;
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.04);
    overflow: hidden;
  }

  .tile-photo {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #000;
  }

  .tile-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms ease-out;
  }

  .group:hover .tile-img {
    transform: scale(1.04);
  }

  .tile-card {
    background: #fff;
    color: #111;
    padding: 22px 16px 24px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }

  .tile-place {
    /* Handwriting script — matches the postcard caption look from the
       reference Adobe Portfolio site. */
    font-family: 'Caveat', cursive;
    font-size: 28px;
    font-weight: 500;
    line-height: 1;
    color: #111;
  }

  .tile-year {
    font-family: 'Caveat', cursive;
    font-style: italic;
    font-size: 16px;
    color: #555;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 767px) {
    .tile-place {
      font-size: 22px;
    }
    .tile-year {
      font-size: 14px;
    }
    .tile-card {
      padding: 14px 12px 16px;
    }
  }
</style>
