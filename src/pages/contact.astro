---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getSiteSettings } from '@lib/site';

const site = await getSiteSettings();
---

<BaseLayout title="Contact" description={`Get in touch with ${site.name}`}>
  <section class="px-6 md:px-12 pt-16 md:pt-20 pb-24 max-w-3xl">
    <header class="mb-12">
      <p class="text-[10px] uppercase tracking-[0.2em] text-[var(--color-fg-dim)] mb-3">
        Contact
      </p>
      <h1 class="font-display text-4xl md:text-5xl leading-[1.05]">Get in touch.</h1>
    </header>

    <div class="space-y-10">
      <div>
        <p class="text-[10px] uppercase tracking-[0.2em] text-[var(--color-fg-dim)] mb-3">Email</p>
        <button
          id="copy-email"
          type="button"
          class="font-display text-2xl md:text-3xl text-[var(--color-fg)] hover:text-[var(--color-accent)] transition-colors"
          data-email={site.email}
        >
          {site.email}
        </button>
        <span id="copy-email-status" class="ml-3 text-xs text-[var(--color-fg-muted)]" aria-live="polite"></span>
      </div>

      {site.socials.length > 0 && (
        <div>
          <p class="text-[10px] uppercase tracking-[0.2em] text-[var(--color-fg-dim)] mb-3">Elsewhere</p>
          <ul class="space-y-2">
            {site.socials.map((s) => (
              <li>
                <a
                  href={s.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-base text-[var(--color-fg)] hover:text-[var(--color-accent)]"
                >
                  {s.label} <span class="text-[var(--color-fg-dim)]">↗</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<script>
  const btn = document.getElementById('copy-email') as HTMLButtonElement | null;
  const status = document.getElementById('copy-email-status');
  if (btn && status) {
    btn.addEventListener('click', async () => {
      const email = btn.dataset.email ?? btn.textContent?.trim() ?? '';
      try {
        await navigator.clipboard.writeText(email);
        status.textContent = 'Copied';
        setTimeout(() => (status.textContent = ''), 1800);
      } catch {
        status.textContent = 'Press ⌘C';
      }
    });
  }
</script>
