---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import VideoEmbed from '@components/VideoEmbed.astro';
import PortfolioCard from '@components/PortfolioCard.astro';
import Image from '@components/Image.astro';
import { getSiteSettings } from '@lib/site';
import { sortPortfolioDesc } from '@lib/portfolio-sort';

const REEL_YOUTUBE_ID = 'qzitlIdZ3Ag';
const REEL_URL = `https://www.youtube.com/watch?v=${REEL_YOUTUBE_ID}`;

const site = await getSiteSettings();
const portfolio = await getCollection('portfolio');
const recent = sortPortfolioDesc(portfolio).slice(0, 6);

// Map social labels to inline icon ids (rendered below).
const socialIcon = (label: string) => {
  const k = label.toLowerCase();
  if (k.includes('youtube')) return 'youtube';
  if (k.includes('instagram')) return 'instagram';
  if (k.includes('linkedin')) return 'linkedin';
  if (k.includes('vimeo')) return 'vimeo';
  return 'link';
};
---

<BaseLayout title="Christian Taylhardat" description={site.bio}>
  {/* ---------------------------------------------------------- HERO */}
  <section class="relative px-6 md:px-12 pt-10 md:pt-14 pb-16 flex flex-col items-center text-center">
    {/* Live clock */}
    <p
      id="live-clock"
      class="mb-2 text-xs tabular-nums tracking-[0.2em] text-[var(--color-fg-dim)] rise"
      style="--rise-delay: 0ms"
    >
      &nbsp;
    </p>

    {/* Available Worldwide */}
    <p
      class="mb-10 md:mb-12 text-[10px] uppercase tracking-[0.4em] text-[var(--color-fg-muted)] font-mono rise"
      style="--rise-delay: 100ms"
    >
      Available Worldwide
    </p>

    {/* Avatar — rounded square, sized just under the sidebar version */}
    <Image
      src={site.avatar}
      alt={site.name}
      class="h-14 w-14 md:h-16 md:w-16 rounded-xl object-cover mb-5 rise"
      loading="eager"
      fetchpriority="high"
      style="--rise-delay: 200ms"
    />

    {/* Big name — left-to-right fade from off-white to dim.
        Tight tracking + Fraunces opsz 144 / SOFT 100 for an editorial feel.
        leading must clear the descender of "y" since bg-clip-text clips the
        gradient to the line-box. */}
    <h1
      class="font-display tracking-[-0.025em] text-5xl md:text-7xl lg:text-8xl leading-[1.25] pb-4 bg-gradient-to-r from-[var(--color-fg)] to-[var(--color-fg-dim)] bg-clip-text text-transparent rise overflow-visible"
      style="font-variation-settings: 'opsz' 144, 'SOFT' 100; --rise-delay: 300ms"
    >
      {site.name}
    </h1>

    {/* Subtitle */}
    <p
      class="mt-3 md:mt-4 text-base md:text-lg text-[var(--color-fg-muted)] rise"
      style="--rise-delay: 400ms"
    >
      {site.title}
    </p>

    {/* Social icons */}
    {site.socials.length > 0 && (
      <div class="mt-5 flex items-center gap-5 rise" style="--rise-delay: 500ms">
        {site.socials.map((s) => (
          <a
            href={s.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={s.label}
            class="text-[var(--color-fg-muted)] hover:text-[var(--color-fg)] transition-colors"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              {socialIcon(s.label) === 'youtube' && (
                <>
                  <path d="M22.5 7.2c-.2-.9-.9-1.6-1.8-1.8C19 5 12 5 12 5s-7 0-8.7.4C2.4 5.6 1.7 6.3 1.5 7.2 1.1 8.9 1.1 12 1.1 12s0 3.1.4 4.8c.2.9.9 1.6 1.8 1.8C5 19 12 19 12 19s7 0 8.7-.4c.9-.2 1.6-.9 1.8-1.8.4-1.7.4-4.8.4-4.8s0-3.1-.4-4.8z" />
                  <polygon points="10,9 16,12 10,15" fill="currentColor" stroke="none" />
                </>
              )}
              {socialIcon(s.label) === 'instagram' && (
                <>
                  <rect x="3" y="3" width="18" height="18" rx="5" />
                  <circle cx="12" cy="12" r="4" />
                  <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" stroke="none" />
                </>
              )}
              {socialIcon(s.label) === 'linkedin' && (
                <>
                  <rect x="3" y="3" width="18" height="18" rx="2" />
                  <line x1="8" y1="10" x2="8" y2="17" />
                  <circle cx="8" cy="7" r="0.7" fill="currentColor" stroke="none" />
                  <path d="M12 17v-4.5a2 2 0 0 1 4 0V17" />
                  <line x1="12" y1="10" x2="12" y2="17" />
                </>
              )}
              {socialIcon(s.label) === 'vimeo' && (
                <path d="M22 7c-.5 3-3.5 7-6 9-1.5 1.2-2.5 1.5-3.5.5-1-1-1.5-3-2.5-6-1-3-1.5-3.5-2.5-2.5L5 9" />
              )}
              {socialIcon(s.label) === 'link' && (
                <>
                  <path d="M10 14a4 4 0 0 0 5.66 0l3-3a4 4 0 1 0-5.66-5.66l-1 1" />
                  <path d="M14 10a4 4 0 0 0-5.66 0l-3 3a4 4 0 1 0 5.66 5.66l1-1" />
                </>
              )}
            </svg>
          </a>
        ))}
      </div>
    )}

    {/* Copy email */}
    <button
      id="copy-email"
      type="button"
      data-email={site.email}
      class="mt-5 inline-flex items-center gap-2 px-5 py-2.5 border hairline border-[var(--color-line)] hover:border-[var(--color-fg-muted)] text-sm text-[var(--color-fg)] transition-colors rise"
      style="--rise-delay: 600ms"
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="9" y="9" width="11" height="11" rx="2" />
        <path d="M5 15V5a2 2 0 0 1 2-2h10" />
      </svg>
      <span id="copy-email-label">Copy email</span>
    </button>
  </section>

  {/* ---------------------------------------------------------- REEL */}
  <section class="px-6 md:px-12 pb-16 md:pb-20">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-xs uppercase tracking-[0.2em] text-[var(--color-fg-muted)] mb-4 md:mb-6">
        Cinematic Reel
      </h2>
      <VideoEmbed url={REEL_URL} title="Cinematic Reel" />
    </div>
  </section>

  {/* ---------------------------------------------------------- RECENT */}
  {recent.length > 0 && (
    <section class="px-6 md:px-12 pb-20 md:pb-24">
      <div class="flex items-baseline justify-between mb-6">
        <h2 class="text-xs uppercase tracking-[0.2em] text-[var(--color-fg-muted)]">
          Recent Work
        </h2>
        <a href="/portfolio" class="text-xs text-[var(--color-fg-muted)] hover:text-[var(--color-fg)]">
          View all →
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
        {recent.map((entry) => (
          <PortfolioCard
            href={`/portfolio/${entry.slug}`}
            title={entry.data.title}
            year={entry.data.year}
            client={entry.data.client}
            category={entry.data.category}
            thumbnail={entry.data.thumbnail}
          />
        ))}
      </div>
    </section>
  )}
</BaseLayout>

<script>
  // Live clock — updates once a minute, locale-formatted, 12h.
  const clock = document.getElementById('live-clock');
  if (clock) {
    const tick = () => {
      const d = new Date();
      clock.textContent = d.toLocaleTimeString([], {
        hour: 'numeric',
        minute: '2-digit',
      });
    };
    tick();
    setInterval(tick, 1000 * 30);
  }

  // Copy-email button
  const btn = document.getElementById('copy-email') as HTMLButtonElement | null;
  const label = document.getElementById('copy-email-label');
  if (btn && label) {
    btn.addEventListener('click', async () => {
      const email = btn.dataset.email ?? '';
      try {
        await navigator.clipboard.writeText(email);
        const original = label.textContent;
        label.textContent = 'Copied — ' + email;
        setTimeout(() => {
          if (label) label.textContent = original ?? 'Copy email';
        }, 2200);
      } catch {
        if (label) label.textContent = email;
      }
    });
  }
</script>
