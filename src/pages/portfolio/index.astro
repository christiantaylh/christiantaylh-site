---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import PortfolioCard from '@components/PortfolioCard.astro';
import { sortPortfolioDesc } from '@lib/portfolio-sort';

const entries = sortPortfolioDesc(await getCollection('portfolio'));

const filters = ['All', 'Film', 'Personal', 'Commercial', 'Live Event'] as const;
---

<BaseLayout title="Portfolio" description="Film & drone projects.">
  <section class="px-6 md:px-12 pt-16 md:pt-20 pb-20">
    <header class="mb-10 text-center">
      <h1 class="font-display text-4xl md:text-5xl leading-[1.05]">
        Portfolio.
      </h1>
    </header>

    {/* Filter pills — centered above the grid */}
    <nav
      class="flex flex-wrap justify-center gap-2 mb-8 md:mb-10"
      aria-label="Filter portfolio by category"
    >
      {filters.map((label) => (
        <button
          type="button"
          data-filter={label}
          data-active={label === 'All'}
          class="filter-pill inline-flex items-center gap-2 px-5 py-2 rounded-full border hairline border-[var(--color-line)] text-sm text-[var(--color-fg-muted)] hover:text-[var(--color-fg)] hover:border-[var(--color-fg-muted)] transition-colors"
        >
          <span>{label}</span>
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            {label === 'All' && (
              <>
                {/* Hamburger — 3-layer stacked burger silhouette */}
                <path d="M2 7c0-2 2-4 6-4s6 2 6 4" />
                <circle cx="6" cy="5" r="0.35" fill="currentColor" stroke="none" />
                <circle cx="8" cy="4.5" r="0.35" fill="currentColor" stroke="none" />
                <circle cx="10" cy="5" r="0.35" fill="currentColor" stroke="none" />
                <path d="M2 8.5c.8.7 1.6-.7 2.5 0s1.7-.7 2.5 0s1.7-.7 2.5 0s1.7-.7 2.5 0" />
                <line x1="2" y1="11" x2="14" y2="11" />
                <path d="M2 11.5c0 1.5 2 2.5 6 2.5s6-1 6-2.5" />
              </>
            )}
            {label === 'Film' && (
              <>
                {/* Film reel — outer rim, center hub, 4 sprocket holes */}
                <circle cx="8" cy="8" r="6" />
                <circle cx="8" cy="8" r="1" fill="currentColor" stroke="none" />
                <circle cx="8" cy="4.5" r="0.8" />
                <circle cx="11.5" cy="8" r="0.8" />
                <circle cx="8" cy="11.5" r="0.8" />
                <circle cx="4.5" cy="8" r="0.8" />
              </>
            )}
            {label === 'Personal' && (
              <>
                {/* Person — head + shoulders */}
                <circle cx="8" cy="5.5" r="2" />
                <path d="M3 14c0-3 2.5-5 5-5s5 2 5 5" />
              </>
            )}
            {label === 'Commercial' && (
              <>
                {/* Briefcase — body + top handle + center latch line */}
                <rect x="2" y="6" width="12" height="8" rx="1" />
                <path d="M6 6V4.5a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1V6" />
                <line x1="2" y1="10" x2="14" y2="10" />
              </>
            )}
            {label === 'Live Event' && (
              <>
                {/* Microphone — capsule head, U-catcher, stand, base */}
                <rect x="6" y="2" width="4" height="7" rx="2" />
                <path d="M3.5 7.5c0 2.5 2 4.5 4.5 4.5s4.5-2 4.5-4.5" />
                <line x1="8" y1="12" x2="8" y2="14" />
                <line x1="5.5" y1="14" x2="10.5" y2="14" />
              </>
            )}
          </svg>
        </button>
      ))}
    </nav>

    {entries.length === 0 ? (
      <p class="text-sm text-[var(--color-fg-muted)]">
        No projects yet. Add entries via the CMS at <a href="/admin" class="underline">/admin</a>.
      </p>
    ) : (
      <div
        id="portfolio-grid"
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-2 md:gap-3"
      >
        {entries.map((entry) => (
          <div data-card-category={entry.data.category ?? ''}>
            <PortfolioCard
              href={`/portfolio/${entry.slug}`}
              title={entry.data.title}
              year={entry.data.year}
              client={entry.data.client}
              category={entry.data.category}
              thumbnail={entry.data.thumbnail}
            />
          </div>
        ))}
      </div>
    )}
  </section>
</BaseLayout>

<style>
  .filter-pill[data-active='true'] {
    background: var(--color-bg-raised);
    color: var(--color-fg);
    border-color: var(--color-bg-raised);
  }
</style>

<script>
  const pills = document.querySelectorAll<HTMLButtonElement>('.filter-pill');
  const cards = document.querySelectorAll<HTMLElement>('[data-card-category]');

  pills.forEach((pill) => {
    pill.addEventListener('click', () => {
      const filter = pill.dataset.filter ?? 'All';

      pills.forEach((p) => {
        p.dataset.active = String(p === pill);
      });

      cards.forEach((card) => {
        const category = card.dataset.cardCategory ?? '';
        const show = filter === 'All' || category === filter;
        card.classList.toggle('hidden', !show);
      });
    });
  });
</script>
